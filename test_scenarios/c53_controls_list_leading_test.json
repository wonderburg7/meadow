      "ticks": 10
    },
    {
      "do": "assert",
      "condition": {
        "control": "settings/**/ControlsHelp",
        "visible": true,
        "max_leading": 2
      }
    },
    {
      "do": "set_config",
      "key": "text_scale",
      "value": 1.0
    },
    {
      "do": "settle",
      "ticks": 10
    },
    {
      "do": "assert",
