{
  "cells": 15, "nectar_foragers": 8, "pollen_foragers": 3,
  "nurses": 2, "builders": 2, "miners": 0,
  "weather": false, "disease": false, "rival_hive": false, "winter": false,
  "random_seed": 4242,
  "config_overrides": {
    "seconds_per_day": 20,
    "scouting_on": true, "auto_recruitment_on": true,
    "bee_lifespan_days": 200,
    "honey_ripen_time": 0.0
  },
  "snapshot_seconds": 20,
  "actions": [
    {"do": "set_config", "key": "scouting_on", "value": true},
    {"do": "set_config", "key": "auto_recruitment_on", "value": true},
    {"do": "set_cell_contents", "cell": {"built_index": 0}, "resource": "nectar", "amount": 100},
    {"do": "set_cell_contents", "cell": {"built_index": 1}, "resource": "nectar", "amount": 100},
    {"do": "set_cell_contents", "cell": {"built_index": 3}, "resource": "pollen", "amount": 150},
    {"do": "settle", "ticks": 2},
    {
      "when": {"bee_states": {"target": {"is_scouting": true}, "in": ["IN_HIVE_TO_EXIT"], "mode": "any"}},
      "do": "assert",
      "condition": {"bee_states": {"target": {"is_scouting": true}, "not_in": ["AT_ENTRANCE_SEEKING"]}}
    },
    {
      "when": {"bee_states": {"target": {"is_scouting": true}, "in": ["MOVE_TO_POINT"], "mode": "any"}},
      "do": "assert",
      "condition": {"bee_states": {"target": {"is_scouting": true}, "not_in": ["AT_ENTRANCE_SEEKING"]}}
    },
    {
      "when": {"event_count_at_least": {"type": "scouting_settled", "count": 8}},
      "do": "set_bee_stats",
      "target": {"current_role": "forager", "count": 1},
      "trips_scored": 5, "avg_collection_rate": 0.0
    },
    {
      "when": {"event_count_at_least": {"type": "scouting_settled", "count": 8}, "bee_states": {"target": {"current_role": "forager", "count": 1}, "in": ["AT_ENTRANCE_SEEKING"]}},
      "do": "assert",
      "condition": {"bee_states": {"target": {"current_role": "forager", "count": 1}, "in": ["AT_ENTRANCE_SEEKING"]}}
    }
  ],
  "stop": {"max_days": 40}
}
