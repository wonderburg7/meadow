{
  "cells": 15,
  "nectar_foragers": 0,
  "pollen_foragers": 0,
  "nurses": 0,
  "builders": 1,
  "miners": 0,
  "random_seed": 4242,
  "diagnostics": {
    "profile": "custom",
    "events": ["build_target"],
    "limits": {"event_lines_per_type": 8}
  },
  "actions": [
    {
      "do": "queue_build",
      "target": {"current_role": "comb_worker", "count": 1},
      "hex": [3, 0]
    },
    {
      "when": {"cells_completed_at_least": 1},
      "do": "assert",
      "condition": {"queen_alive": true}
    }
  ],
  "stop": {"when_actions_resolved": true, "max_days": 1}
}
