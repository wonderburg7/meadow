{
  "cells": 20, "nectar_foragers": 5, "pollen_foragers": 3,
  "nurses": 3, "builders": 2, "miners": 1,
  "random_seed": 4242,
  "actions": [
    {
      "when": {"day_at_least": 1},
      "do": "assign_role",
      "target": {"current_role": "nurse", "count": 10},
      "role": "nurse_both"
    },
    {
      "when": {"event_count_at_least": {"type": "brood_hatch", "count": 1}},
      "do": "assert",
      "condition": {"event_count_at_least": {"type": "brood_feed", "count": 1}}
    }
  ],
  "stop": {"when_actions_resolved": true, "max_days": 10}
}
