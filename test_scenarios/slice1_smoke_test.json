{
  "cells": 10, "nectar_foragers": 3, "pollen_foragers": 2,
  "nurses": 1, "builders": 1, "miners": 1,
  "random_seed": 4242,
  "diagnostics": {"profile": "verdict"},
  "actions": [
    {
      "do": "assert",
      "when": {"cells_completed_at_least": 11},
      "condition": {
        "queen_alive": true,
        "population_at_least": {"count": 1},
        "cells_completed_at_least": 11
      }
    }
  ],
  "expect": [
    {"id": "clean_actions", "metric": "actions.problems", "op": "empty"},
    {"id": "queen_alive", "metric": "summary.queen_alive", "op": "eq", "value": true},
    {"id": "population_survives", "metric": "summary.total_deaths", "op": "eq", "value": 0}
  ],
  "stop": {"when_actions_resolved": true, "max_days": 3}
}
