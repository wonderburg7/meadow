{
  "cells": 15, "nectar_foragers": 4, "pollen_foragers": 2,
  "nurses": 2, "builders": 1, "miners": 0,
  "random_seed": 101,
  "actions": [
    {"do": "set_config", "key": "seconds_per_day", "value": 20.0},
    {"do": "save_run", "name": "SV1 scenario", "when": {"day_at_least": 2}},
    {"do": "wait", "seconds": 430},
    {"do": "assert", "condition": {"save_slot": "SV1 scenario", "named": true, "checkpoint_files": 3, "next_checkpoint": 2}},
    {"do": "restore_slot", "name": "SV1 scenario"},
    {"do": "settle", "ticks": 1},
    {"do": "assert", "condition": {"save_slot": "SV1 scenario", "named": true, "day_matches_saved": true}}
  ],
  "stop": {"when_actions_resolved": true, "max_days": 30}
}
