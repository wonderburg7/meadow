{
  "cells": 15, "nectar_foragers": 4, "pollen_foragers": 2,
  "nurses": 2, "builders": 1, "miners": 0,
  "random_seed": 202,
  "actions": [
    {"do": "viewport_size", "w": 1280, "h": 720},
    {"do": "save_run", "name": "SV2 scenario", "when": {"day_at_least": 1}},
    {"do": "settle", "ticks": 2},
    {"do": "open_window", "window": "saves"},
    {"do": "settle", "ticks": 3},
    {"do": "assert", "condition": {"panel": "saves", "inside_viewport": true}},
    {"do": "assert", "condition": {"save_slot": "SV2 scenario", "named": true}},
    {"do": "open_window", "window": "colony"},
    {"do": "settle", "ticks": 3},
    {"do": "assert", "condition": {"panel": "colony", "inside_viewport": true}}
  ],
  "stop": {"when_actions_resolved": true, "max_days": 2}
}
