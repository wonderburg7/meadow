{
  "cells": 15, "nectar_foragers": 4, "pollen_foragers": 2,
  "nurses": 2, "builders": 2, "miners": 1,
  "random_seed": 4242,
  "actions": [
    {"do": "select_bees", "target": {"any_of": [
      {"current_role": "miner", "count": 1},
      {"current_role": "comb_worker", "count": 1}
    ]}},
    {"do": "request_placement_tool", "tool": "build_cell"},
    {"do": "request_placement_tool", "tool": "mine_target"},
    {"do": "click_world", "view": "hive", "soil_hex": [-5, -5]},
    {"do": "settle", "ticks": 1},
    {"do": "assert", "condition": {"selected_mine_queue_at_least": 1}},
    {"do": "assert", "condition": {"built_cells_at_least": 0}}
  ],
  "stop": {"when_actions_resolved": true, "max_days": 1}
}
