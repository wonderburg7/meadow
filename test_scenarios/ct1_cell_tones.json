    {"do": "set_cell_contents", "cell": {"built_index": 1}, "resource": "honey", "amount": 200},
    {"do": "set_cell_contents", "cell": {"built_index": 2}, "resource": "pollen", "amount": 200},
    {"do": "set_cell_contents", "cell": {"built_index": 3}, "resource": "nectar", "amount": 200},
    {"do": "set_cell_contents", "cell": {"built_index": 4}, "resource": "bee_bread", "amount": 60},
    {"do": "close_cell", "cell": {"built_index": 0}},
