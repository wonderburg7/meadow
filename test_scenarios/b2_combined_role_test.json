{
  "cells": 15, "nectar_foragers": 1, "nurses": 2, "builders": 1, "miners": 1,
  "actions": [
    {
      "when": {"day_at_least": 1},
      "do": "assign_role",
      "target": {"current_role": "nurse", "count": 2},
      "role": "forager_pollen"
    },
    {
      "when": {"day_at_least": 2},
      "do": "assert",
      "condition": {"population_at_least": {"role": "forager", "count": 3}}
    }
  ],
  "stop": {"max_days": 3}
}
