# Godot engine cache
.godot/
# GPU shader cache Godot drops into the project folder
NVIDIA Corporation/
# Manual pre-slice snapshots -- git history replaces these
_backups/
# Per-user Claude permissions and temporary task state
.claude/settings.local.json
.claude/scheduled-task*.lock
# Python bytecode caches from tools/
__pycache__/
*.pyc

# Slice worktrees (tools/slice.ps1). They are git worktrees, not content:
# `git add -A` from the primary checkout would otherwise embed one.
.worktrees/

# Packaged alpha builds are reproducible artifacts.
build/
